  #organizations = [ {name = "Senior Lecturer", url = "https://fds.duke.edu/db/aas/math/faculty/rann"}, { name = "Mathematics Department", url = "https://www.math.duke.edu/"}, { name = "Duke University", url = "https://www.duke.edu" }]

